# Токен бота @Lpvolley_bot от @BotFather
BOT_TOKEN=

# Публичный сайт, к которому relay обращается за данными
SITE_BASE=https://lpvolley.ru

# Общий длинный секрет; должен совпадать с TELEGRAM_AGENT_SECRET на сайте
TELEGRAM_AGENT_SECRET=

# Explicit single owner for personal telegram_outbox delivery. The web cron
# only bridges V2 domain events and never calls Telegram Bot API.
TELEGRAM_OUTBOX_OWNER=relay

# Числовые Telegram user ID организаторов, которым можно подтверждать карточки.
# Обязателен для модерации; несколько ID перечисляются через запятую.
TELEGRAM_ADMIN_USER_IDS=

# Необязательные интервалы
POLL_TIMEOUT_SEC=25
RELAY_INTERVAL_SEC=30
